{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "apc-snag-daily-report",
  "main": "index.js",
  "compatibility_date": "2026-05-17",
  "observability": { "enabled": true },
  "triggers": {
    // 06:00 UTC = 07:00 UK in summer (BST), 06:00 UK in winter.
    "crons": ["0 6 * * *"]
  }
}
