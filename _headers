# Cloudflare Pages / Netlify security headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'self'
  Strict-Transport-Security: max-age=31536000

# Long-cache immutable static assets
/images/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# site.js boots the launcher + nudges on every page and is edited often —
# force a revalidate on every load so fixes go live without a stale 4h cache.
/site.js
  Cache-Control: public, max-age=0, must-revalidate

# APC Phase 1 snag tool — private site tool, keep out of every index
# and never cache (live job data behind a PIN).
/apc-p1-28f2a2ab/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
